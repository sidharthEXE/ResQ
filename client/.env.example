# ==============================================================================
# EMERGENCY FINDER FRONTEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================================
# Instructions: Copy this file to '.env' and populate your API keys.
# DO NOT commit actual keys to source control.

# Google Maps JavaScript API Key
# ------------------------------------------------------------------------------
# Security Recommendations in Google Cloud Console Credentials:
# 1. Application Restrictions: HTTP Referrers (Websites)
#    Allowed URLs:
#      - http://localhost:5173/*
#      - http://127.0.0.1:5173/*
#      - https://yourdomain.com/*
# 2. API Restrictions:
#    Restrict key strictly to "Maps JavaScript API"
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Optional: Google Maps Vector Map ID (for Advanced Marker rendering & Dark styling)
VITE_GOOGLE_MAPS_MAP_ID=YOUR_OPTIONAL_MAP_ID_HERE
